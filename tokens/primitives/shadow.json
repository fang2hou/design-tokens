{
  "$description": "Box-shadow primitives as CSS values. Untyped tokens: consumers treat $value as a ready box-shadow string. Light and dark sets differ in opacity because dark surfaces need stronger separation.",
  "shadow": {
    "light": {
      "sm": {
        "$value": "0 1px 2px rgba(29, 32, 33, 0.08)",
        "$description": "Resting chips, inputs"
      },
      "md": { "$value": "0 4px 12px rgba(29, 32, 33, 0.10)", "$description": "Cards, dropdowns" },
      "lg": { "$value": "0 12px 32px rgba(29, 32, 33, 0.14)", "$description": "Modals, popovers" }
    },
    "dark": {
      "sm": { "$value": "0 1px 2px rgba(0, 0, 0, 0.35)", "$description": "Resting chips, inputs" },
      "md": { "$value": "0 4px 12px rgba(0, 0, 0, 0.45)", "$description": "Cards, dropdowns" },
      "lg": { "$value": "0 16px 40px rgba(0, 0, 0, 0.55)", "$description": "Modals, popovers" }
    }
  }
}
